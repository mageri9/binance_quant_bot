# Telegram Bot
BOT_TOKEN=123456:your_telegram_bot_token_here
ADMIN_IDS=[123456789]

# Trading Mode: paper | testnet | mainnet
TRADING_MODE=testnet

# Binance API (для testnet/mainnet)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_PROXY=

# Nexus SRE Integration (Ваш SDK)
NEXUS_APP_SECRET=your_nexus_app_secret
NEXUS_ENDPOINT_URL=http://nexus-webhook:8000/events/app
NEXUS_PROJECT_NAME=binance_quant_bot

# Database
DATABASE_URL=sqlite+aiosqlite:///./marketmind.db

# Risk Management
RISK_MAX_ALLOCATION_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_CONSECUTIVE_LOSSES_LIMIT=5

# Strategy Defaults
DEFAULT_SL_PCT=0.02
DEFAULT_TP_PCT=0.04
DEFAULT_TIMEOUT_CANDLES=5
DEFAULT_COMMISSION_RATE=0.0004
MIN_EXPECTED_RETURN=0.001
